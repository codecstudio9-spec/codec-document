{
  "manifest_version": 3,
  "name": "Codec Document — Descargador DIAN",
  "version": "1.0.0",
  "description": "Descarga tus documentos electrónicos de la DIAN a tu computador, usando tu propia sesión de navegador — no la de un servidor compartido.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads", "storage", "cookies"],
  "host_permissions": [
    "https://catalogo-vpfe.dian.gov.co/*",
    "https://catalogo-vpfe-hab.dian.gov.co/*",
    "https://vpfe.dian.gov.co/*",
    "https://vpfe-hab.dian.gov.co/*"
  ]
}
