{
  "manifest_version": 3,
  "name": "Codec Document — Descargador DIAN",
  "version": "2.3.2",
  "description": "Descarga tus documentos electrónicos de la DIAN a tu computador, usando tu propia sesión de navegador.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads", "storage", "unlimitedStorage", "cookies", "scripting", "alarms", "debugger"],
  "host_permissions": [
    "https://catalogo-vpfe.dian.gov.co/*",
    "https://catalogo-vpfe-hab.dian.gov.co/*",
    "https://vpfe.dian.gov.co/*",
    "https://vpfe-hab.dian.gov.co/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.codecdocument.com/*",
      "https://codecdocument.com/*",
      "http://localhost:5174/*"
    ]
  }
}
