{
  "manifest_version": 3,
  "name": "Codec Document — Descargador DIAN",
  "version": "3.0.6",
  "description": "Descarga tus documentos electrónicos de la DIAN por rango de fechas o por CUFE, usando tu propia sesión de navegador.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "cookies",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://catalogo-vpfe.dian.gov.co/*",
    "https://catalogo-vpfe-hab.dian.gov.co/*",
    "https://vpfe.dian.gov.co/*",
    "https://vpfe-hab.dian.gov.co/*",
    "https://yxzchnldmfsgdtbjurey.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://www.codecdocument.com/*",
      "https://codecdocument.com/*",
      "http://localhost:5174/*"
    ]
  },
  "key": ""
}